# Copiá este archivo como .env (en esta misma carpeta) y pegá tu API key de Gemini.
# La key se crea en Google AI Studio. Nunca la subas a git ni la pegues en el chat.
GEMINI_API_KEY=
# Opcional: modelo por defecto (gemini-3.8-flash, gemini-3.6-flash o gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash
# Opcional: puerto local
PORT=3020
